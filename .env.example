# Local-only inference settings; no API keys are required.
OLLAMA_HOST=http://127.0.0.1:11434
LEARNLENS_OLLAMA_MODEL=llama3.2:1b
# Optional image Q&A model; it must support vision and be installed in Ollama.
LEARNLENS_OLLAMA_VISION_MODEL=llava:7b
# Faster local video transcription defaults; use "base" for higher accuracy.
LEARNLENS_WHISPER_MODEL=tiny
LEARNLENS_WHISPER_GPU=true
LEARNLENS_WHISPER_BEAM_SIZE=1
LEARNLENS_WHISPER_CPU_THREADS=4
# SQLite state location and local profile identifier.
LEARNLENS_STATE_DB=learnlens.db
LEARNLENS_PROFILE_ID=local
# Optional Gemini settings for Auto or Online text-generation mode.
# GEMINI_API_KEY=your_key_here
# LEARNLENS_GEMINI_MODEL=gemini-2.5-flash
